+#ifdef SQLITE_DIRECT_OVERFLOW_READ
+/*
+** OvVec: classify three successive overflow pages of a chain.
+**
+** Returns +1 if p0,p1,p2 are physically consecutive and ascending, -1 if they
+** are physically consecutive and descending, and 0 otherwise.
+**
+** A descending run is exactly as batchable as an ascending one -- the pages
+** still form a single contiguous extent on disk, they are merely consumed
+** from the high end.  This matters because SQLite's free-list returns pages
+** in descending order after a bulk DELETE, so in any database that has had a
+** large delete applied to it the overflow chains run backwards; a
+** forward-only test sees no contiguity at all in that (very common) case.
+*/
+static int ovvecRunDir(Pgno p0, Pgno p1, Pgno p2){
+  if( p0+1==p1 && p1+1==p2 ) return 1;
+  if( p1+1==p0 && p2+1==p1 ) return -1;
+  return 0;
+}
+
+/*
+** OvVec: length of the physically contiguous run of overflow pages that ends
+** at entry iEnd of the chain cache aOverflow[].  Returns 0 if that entry has
+** not been learned yet.
+**
+** This is what sizes the speculative window.  A window wider than the run
+** reads pages that are then discarded: harmless when the data is cold, since
+** the device fetches the whole extent either way, but pure wasted copying when
+** the pages are already in the page cache -- which is exactly where a fixed
+** window was measured to lose.  Reading the previous run's length out of the
+** chain cache costs nothing and needs no extra state.
+**
+** The scan stops once nLimit pages have been counted, so a caller that only
+** needs to distinguish "at least N" pays O(N) rather than O(run).  Without
+** that bound the walk is repeated for every speculative decision and the cost
+** of reading one BLOB grows quadratically: measured at 67,452 backwards steps
+** for a 16 MiB BLOB but 67,298,517 for a 512 MiB one.
+*/
+static int ovvecRunLenAt(Pgno *a, int iEnd, int nLimit){
+  int n = 1;
+  int d = 0;
+  int i = iEnd;
+  if( iEnd<0 || a[iEnd]==0 ) return 0;
+  while( i>0 && n<nLimit && a[i-1]!=0 ){
+    int dd = (a[i-1]+1==a[i]) ? 1 : (a[i]+1==a[i-1]) ? -1 : 0;
+    if( dd==0 || (d!=0 && dd!=d) ) break;
+    d = dd;
+    n++;
+    i--;
+  }
+  return n;
+}
+#endif /* SQLITE_DIRECT_OVERFLOW_READ */
+
