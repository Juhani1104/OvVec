+++ b/src/os_unix.c	2026-09-22 16:41:48.952842313 +0000
@@ -46,6 +46,10 @@
 #include "sqliteInt.h"
 #if SQLITE_OS_UNIX              /* This file is used on unix only */
 
+#if defined(__linux__)
+# include <sys/uio.h>
+#endif
+
 /*
 ** There are various methods for file locking used for concurrency
 ** control:
@@ -4156,6 +4160,62 @@
     }
 #endif /* __linux__ && SQLITE_ENABLE_BATCH_ATOMIC_WRITE */
 
+#if defined(__linux__)
+    /* OvVec: read N contiguous SQLite overflow pages with a single
+    ** preadv(). The 4-byte next-page pointer of each page is scattered
+    ** into p->aNext; the remaining bytes are scattered directly into the
+    ** final BLOB output buffer, so no full-BLOB memcpy is needed.
+    **
+    ** p->dir says which way the chain walks through the extent. For a
+    ** descending chain the physical page at position i is logical page
+    ** nPage-1-i, so the iovec array is simply filled back to front; the
+    ** read itself is identical. */
+    case SQLITE_FCNTL_OVVEC_READ: {
+      OvVecReadReq *p = (OvVecReadReq*)pArg;
+      struct iovec aIov[SQLITE_OVVEC_MAX_PAGES * 2];
+      ssize_t nRead;
+      ssize_t nExpect;
+      int i;
+
+      if( p==0
+       || p->nPage<1
+       || p->nPage>SQLITE_OVVEC_MAX_PAGES
+       || p->szPage<8
+       || p->szPayload!=(p->szPage-4)
+       || p->pOut==0
+       || p->aNext==0
+       || (p->dir!=1 && p->dir!=-1)
+      ){
+        return SQLITE_NOTFOUND;
+      }
+
+      /* Each SQLite overflow page becomes two iovec entries:
+      ** [4-byte pointer][payload]. */
+      for(i=0; i<p->nPage; i++){
+        int slot = p->dir>0 ? i : p->nPage-1-i;
+        aIov[i*2].iov_base = &p->aNext[slot*4];
+        aIov[i*2].iov_len = 4;
+        aIov[i*2+1].iov_base = &p->pOut[slot*p->szPayload];
+        aIov[i*2+1].iov_len = (size_t)p->szPayload;
+      }
+
+      nExpect = (ssize_t)p->nPage * (ssize_t)p->szPage;
+
+      do{
+        nRead = preadv(pFile->h, aIov, p->nPage * 2, (off_t)p->iOffset);
+      }while( nRead<0 && errno==EINTR );
+
+      if( nRead<0 ){
+        pFile->lastErrno = errno;
+        return SQLITE_IOERR_READ;
+      }
+      if( nRead!=nExpect ){
+        return SQLITE_IOERR_SHORT_READ;
+      }
+      return SQLITE_OK;
+    }
+#endif
+
     case SQLITE_FCNTL_NULL_IO: {
       osClose(pFile->h);
       pFile->h = -1;
