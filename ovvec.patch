+        return SQLITE_NOTFOUND;
+      }
+
+      /* Each SQLite overflow page becomes two iovec entries:
+      ** [4-byte pointer][payload]. */
+      for(i=0; i<p->nPage; i++){
+        aIov[i*2].iov_base = &p->aNext[i*4];
+        aIov[i*2].iov_len = 4;
+        aIov[i*2+1].iov_base = &p->pOut[i*p->szPayload];
+        aIov[i*2+1].iov_len = (size_t)p->szPayload;
+      }
+
+      nExpect = (ssize_t)p->nPage * (ssize_t)p->szPage;
+
+      do{
+        nRead = preadv(pFile->h, aIov, p->nPage * 2, (off_t)p->iOffset);
+      }while( nRead<0 && errno==EINTR );
+
+      if( nRead<0 ){
+        pFile->lastErrno = errno;
+        return SQLITE_IOERR_READ;
+      }
+      if( nRead!=nExpect ){
+        return SQLITE_IOERR_SHORT_READ;
+      }
+      return SQLITE_OK;
