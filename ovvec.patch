+static int ovvecWalFlush(WalWriter *p, OvVecWalBatch *pB){
+  OvVecWriteReq x;
+  int rc;
+  if( pB->n==0 ) return SQLITE_OK;
+  memset(&x, 0, sizeof(x));
+  x.iOffset = pB->iOffset;
+  x.nIov = pB->n*2;
+  x.aIov = pB->aIov;
+  rc = sqlite3OsFileControl(p->pFd, SQLITE_FCNTL_OVVEC_WRITE, &x);
+  if( rc==SQLITE_NOTFOUND ){
+    /* No vectored write here: write the same buffers one at a time, which is
+    ** exactly what the original code did. */
+    int i;
+    i64 iOff = pB->iOffset;
+    rc = SQLITE_OK;
+    for(i=0; i<pB->n*2 && rc==SQLITE_OK; i++){
+      rc = walWriteToLog(p, (void*)pB->aIov[i].pBuf, pB->aIov[i].nBuf, iOff);
+      iOff += pB->aIov[i].nBuf;
+    }
+  }
+  if( rc==SQLITE_OK ) pB->n = 0;
+  return rc;
