+           && pBt->usableSize==pBt->pageSize
+           && a==ovflSize
+           && amt>=ovflSize
+           && iIdx>=2
+           && (ovvecDir = ovvecRunDir(pCur->aOverflow[iIdx-2],
+                                      pCur->aOverflow[iIdx-1], nextPage))!=0
+           && sqlite3PagerDirectReadOk(pBt->pPager, nextPage)
+          ){
+            int nOvfl;
+            int nFull;
+            int nCand;
+            int accepted;
+            int j;
+            Pgno startPg = nextPage;
+            Pgno pgAfter;
+            unsigned char aNext[SQLITE_OVVEC_MAX_PAGES*4];
+            OvVecReadReq x;
+            int rcVec;
+
+            nOvfl = (pCur->info.nPayload-pCur->info.nLocal+ovflSize-1)/ovflSize;
+
