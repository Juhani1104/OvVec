+/*
+** Return true if pages freed by the current transaction should not be
+** handed out again before it commits.
+**
+** Reusing such a page overwrites content that the rollback journal must be
+** able to restore, so the pager reads the old page and journals it before
+** the new content goes in (see btreeSetHasContent()). Replacing a large
+** value therefore writes the old value to the journal in full -- the same
+** number of bytes again as the new value. A leaf freed by an earlier
+** transaction is reused with neither a read nor a journal record, and a page
+** appended past the original end of the file needs no journal record either.
+**
+** WAL and in-memory journals do not copy old content, and auto-vacuum
+** relies on the free-list being consumed before it truncates, so they keep
+** the stock behaviour.
+*/
+static int btreeAvoidFreshPages(BtShared *pBt){
+  int eMode;
+  if( pBt->autoVacuum ) return 0;
+  eMode = sqlite3PagerGetJournalMode(pBt->pPager);
+  return eMode==PAGER_JOURNALMODE_DELETE
+      || eMode==PAGER_JOURNALMODE_PERSIST
+      || eMode==PAGER_JOURNALMODE_TRUNCATE;
+}
