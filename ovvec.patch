+          ;
+#endif /* SQLITE_OMIT_INCRBLOB */
+
+#ifndef SQLITE_OMIT_INCRBLOB
+          /* OvVec: when the incremental-BLOB overflow-page cache already
+          ** contains a known physically contiguous run, batch those pages
+          ** into a single vectored read instead of one pread() per page.
+          */
+          if( pCur->aOverflow
+           && pBt->usableSize==pBt->pageSize
+           && a==ovflSize
+           && amt>=2*ovflSize
+           && (ovvecDir = (pCur->aOverflow[iIdx+1]==nextPage+1) ? 1
+                        : (pCur->aOverflow[iIdx+1]+1==nextPage) ? -1 : 0)!=0
+           && (ovvecDir>0 || nextPage>=2)
+          ){
+            int nOvfl;
+            int nFull;
+            int nBatch;
+            int j;
+
+            /* Number of overflow pages belonging to this payload. */
+            nOvfl = (pCur->info.nPayload-pCur->info.nLocal+ovflSize-1)/ovflSize;
+
+            /* Number of complete overflow payloads still requested. */
+            nFull = amt/ovflSize;
+            if( nFull>SQLITE_OVVEC_MAX_PAGES ) nFull = SQLITE_OVVEC_MAX_PAGES;
+            if( nFull>(nOvfl-iIdx) ) nFull = nOvfl-iIdx;
+
+            /* Page iIdx is nextPage. Grow nBatch only while following
+            ** entries have already been learned by SQLite's overflow-page
+            ** cache and are physically consecutive. */
+            nBatch = 1;
+            while( nBatch<nFull ){
+              Pgno pg = pCur->aOverflow[iIdx+nBatch];
+              if( pg==0 ) break;
+              if( pg!=(ovvecDir>0 ? nextPage+(Pgno)nBatch
+                                  : nextPage-(Pgno)nBatch) ) break;
+              if( ovvecDir<0 && pg<2 ) break;
+
+              /* Preserve all safety conditions of SQLite's existing
+              ** direct-overflow-read optimization. */
+              if( !sqlite3PagerDirectReadOk(pBt->pPager, pg) ) break;
+              nBatch++;
+            }
+
+            if( nBatch>=2 ){
+              unsigned char aNext[SQLITE_OVVEC_MAX_PAGES*4];
+              OvVecReadReq x;
+              int rcVec;
+              int bChainOk = 1;
+              Pgno pgAfter;
+
+              memset(&x, 0, sizeof(x));
+              x.iOffset = (i64)pBt->pageSize*
+                  ((ovvecDir>0 ? nextPage : nextPage-(Pgno)(nBatch-1)) - 1);
+              x.nPage = nBatch;
+              x.dir = ovvecDir;
+              x.szPage = pBt->pageSize;
+              x.szPayload = ovflSize;
+              x.pOut = pBuf;
+              x.aNext = aNext;
+
+              rcVec = sqlite3OsFileControl(fd, SQLITE_FCNTL_OVVEC_READ, &x);
+
+              if( rcVec==SQLITE_OK ){
+                /* Verify every internal overflow pointer against SQLite's
+                ** already-known aOverflow[] chain. */
+                for(j=0; j<nBatch-1; j++){
+                  Pgno expected = pCur->aOverflow[iIdx+j+1];
+                  if( get4byte(&aNext[j*4])!=expected ){
+                    bChainOk = 0;
+                    break;
+                  }
+                }
+
+                /* Pointer stored in the final page of this batch. */
+                pgAfter = get4byte(&aNext[(nBatch-1)*4]);
+
+                /* If SQLite already knows the next overflow page, validate
+                ** that pointer too. */
+                if( bChainOk
+                 && iIdx+nBatch<nOvfl
+                 && pCur->aOverflow[iIdx+nBatch]!=0
+                 && pgAfter!=pCur->aOverflow[iIdx+nBatch]
