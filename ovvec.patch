+            ** path below is preferable; this path is only for the first
+            ** traversal. */
+            if( iIdx+1<nOvfl && pCur->aOverflow[iIdx+1]!=0 ){
+              goto ovvec_out;
+            }
+
+            /* Number of complete overflow payloads remaining in this
+            ** accessPayload() request. */
+            nFull = amt/ovflSize;
+            if( nFull>nOvfl-iIdx ) nFull = nOvfl-iIdx;
+
+            /* Size the window from what this chain has already shown us:
+            ** how many pages of the current run are still expected, given how
+            ** long the previous run turned out to be.  Fall back to the
+            ** doubling schedule only while no complete run has been seen. */
+            {
+              /* Four pages is all that is needed to tell whether this run is
+              ** already established; beyond that the previous run's length is
+              ** never consulted, so neither walk has to be unbounded. */
+              int nInRun = ovvecRunLenAt(pCur->aOverflow, iIdx-1, 4);
+              /* The window is nPrev-nInRun, and it must still be able to reach
+              ** SQLITE_OVVEC_MAX_PAGES, so the bound on nPrev has to leave room
+              ** for the subtraction: nInRun is below 4 on this branch. */
+              int nPrev  = nInRun>=4 ? 0
+                         : ovvecRunLenAt(pCur->aOverflow, iIdx-nInRun-1,
+                                         SQLITE_OVVEC_MAX_PAGES+4);
+              if( nInRun>=4 ){
+                /* Already well inside a run: this run has proven itself, so
+                ** grow with the doubling schedule instead of taking a prior
+                ** from an older, unrelated run.  Without this a long run that
+                ** happens to follow an isolated single-page hop would never be
+                ** batched at all. */
+                nCand = ovvecFirstWindow;
+              }else if( nPrev==0 ){
+                /* No complete run seen yet: fall back to the doubling
+                ** schedule, which is what a single long run needs. */
+                nCand = ovvecFirstWindow;
+              }else if( nPrev==1 ){
+                /* The previous run was a single page.  This chain is made of
+                ** isolated hops, so any speculation is wasted I/O. */
+                nCand = 0;
+              }else if( nPrev>nInRun ){
+                nCand = nPrev - nInRun;
+                if( nCand<2 ) nCand = 2;
+              }else{
+                /* This run is already longer than the last one was; extend
+                ** cautiously rather than guessing wide. */
+                nCand = 2;
+              }
+            }
+
+            /* Bound the speculative read in bytes as well as in pages. */
+            if( (i64)nCand*pBt->pageSize > SQLITE_OVVEC_MAX_BYTES ){
+              nCand = (int)(SQLITE_OVVEC_MAX_BYTES/pBt->pageSize);
+              if( nCand<2 ) nCand = 2;
+            }
+            if( nCand>nFull ) nCand = nFull;
+            if( nCand>SQLITE_OVVEC_MAX_PAGES ) nCand = SQLITE_OVVEC_MAX_PAGES;
+
+            /* Never speculate beyond the physical database, and for a
+            ** descending run never below page 2 (page 1 is the file header
+            ** and can never be an overflow page). */
+            if( nextPage>pBt->nPage || nextPage<2 ){
+              nCand = 0;
+            }else if( ovvecDir>0 ){
+              if( (Pgno)nCand>pBt->nPage-nextPage+1 ){
+                nCand = (int)(pBt->nPage-nextPage+1);
+              }
+            }else{
+              if( (Pgno)nCand>nextPage-1 ){
+                nCand = (int)(nextPage-1);
+              }
+            }
+
+            /* Preserve SQLite's existing direct-read safety requirement
+            ** for every page in the candidate window. */
+            for(j=1; j<nCand; j++){
+              Pgno pgJ = ovvecDir>0 ? nextPage+(Pgno)j : nextPage-(Pgno)j;
+              if( !sqlite3PagerDirectReadOk(pBt->pPager, pgJ) ){
+                nCand = j;
+                break;
+              }
+            }
+
+            /* A one-page preadv() is not useful. */
+            if( nCand>=2 ){
+              memset(&x, 0, sizeof(x));
+              /* iOffset addresses the lowest page of the extent, which for a
+              ** descending run is the last page of the window. */
+              x.iOffset = (i64)pBt->pageSize*
+                  ((ovvecDir>0 ? nextPage : nextPage-(Pgno)(nCand-1)) - 1);
+              x.nPage = nCand;
+              x.dir = ovvecDir;
+              x.szPage = pBt->pageSize;
+              x.szPayload = ovflSize;
+              x.pOut = pBuf;
+              x.aNext = aNext;
+
+              rcVec = sqlite3OsFileControl(fd, SQLITE_FCNTL_OVVEC_READ, &x);
+
+              if( rcVec==SQLITE_OK ){
+                /* The first physical page is definitely the current
+                ** overflow page. */
+                accepted = 1;
+                pgAfter = get4byte(&aNext[0]);
+
+                /* Accept only the prefix whose links confirm that the next
+                ** logical overflow page continues the run in the direction
+                ** we speculated on. */
+                while( accepted<nCand
+                    && pgAfter==(ovvecDir>0 ? startPg+(Pgno)accepted
+                                            : startPg-(Pgno)accepted) ){
+                  pgAfter = get4byte(&aNext[accepted*4]);
+                  accepted++;
+                }
+
+                /* Record accepted pages into SQLite's normal overflow
+                ** cache. */
+                for(j=0; j<accepted; j++){
+                  Pgno expected = ovvecDir>0 ? startPg+(Pgno)j
+                                             : startPg-(Pgno)j;
+                  assert( pCur->aOverflow[iIdx+j]==0
+                       || pCur->aOverflow[iIdx+j]==expected
+                       || CORRUPT_DB );
+                  pCur->aOverflow[iIdx+j] = expected;
+                }
+
+                /* Full success and the chain continues in the same
+                ** direction: 8->16->32->64->128 */
+                if( accepted==nCand
+                 && pgAfter==(ovvecDir>0 ? startPg+(Pgno)nCand
+                                         : startPg-(Pgno)nCand) ){
+                  if( ovvecFirstWindow<SQLITE_OVVEC_MAX_PAGES ){
+                    ovvecFirstWindow *= 2;
+                    if( ovvecFirstWindow>SQLITE_OVVEC_MAX_PAGES ){
+                      ovvecFirstWindow = SQLITE_OVVEC_MAX_PAGES;
+                    }
+                  }
+                }else{
+                  /* Run ended. Return to conservative window for the next
+                  ** newly-observed run. */
+                  ovvecFirstWindow = 8;
+                }
+
+                {
+                  int nByte = accepted*ovflSize;
+                  nextPage = pgAfter;
+                  amt -= nByte;
+                  pBuf += nByte;
+                  offset = 0;
+
+                  /* continue skips SQLite's normal iIdx++ at the bottom of
+                  ** while(nextPage), so consume the entire accepted prefix
+                  ** here. */
+                  iIdx += accepted;
+
+                  if( amt==0 ) return SQLITE_OK;
+                  continue;
+                }
