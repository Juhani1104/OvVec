+typedef struct OvVecWalBatch OvVecWalBatch;
+struct OvVecWalBatch {
+  int n;                               /* Frames held */
+  i64 iOffset;                         /* Offset of the first held frame */
+  OvVecIov aIov[SQLITE_OVVEC_MAX_IOV]; /* Header and image of each frame */
+  u8 aHdr[SQLITE_OVVEC_MAX_PAGES][WAL_FRAME_HDRSIZE];
