diff -ruN a/src/os.h b/src/os.h
--- a/src/os.h	2026-09-22 16:41:48.951342624 +0000
+++ b/src/os.h	2026-09-22 16:41:48.951803941 +0000
@@ -182,6 +182,56 @@
 int sqlite3OsLock(sqlite3_file*, int);
 int sqlite3OsUnlock(sqlite3_file*, int);
 int sqlite3OsCheckReservedLock(sqlite3_file *id, int *pResOut);
+/*
+** OvVec prototype.
+**
+** Private file-control used internally by SQLite.
+**
+** It reads a physically contiguous run of overflow pages using
+** scatter/gather I/O. For each page:
+**
+**   bytes 0..3       -> aNext[]
+**   bytes 4..end     -> pOut[]
+**
+** The run may be traversed in either direction. dir is +1 when the chain
+** walks from low page numbers to high, -1 when it walks from high to low;
+** iOffset always addresses the LOWEST page of the run. Both cases are one
+** contiguous extent on disk and therefore one preadv(); only the mapping
+** from physical position to output slot differs.
+**
+** The public sqlite3_io_methods ABI is unchanged.
+*/
+#define SQLITE_FCNTL_OVVEC_READ 0x4f565643
+#define SQLITE_OVVEC_MAX_PAGES 128
+
+/*
+** Upper bound, in bytes, on a single speculative vectored read.
+**
+** The cost of guessing a run longer than it really is amounts to
+** (window - run) * pageSize wasted bytes, so a window counted in PAGES
+** over-reads sixteen times as much at a 64 KiB page size as at 4 KiB. With a
+** page-counted window only, a chain of mostly single-page hops at 64 KiB pages
+** read 4,778 KiB where stock read 3,434 KiB -- 39% more data to save six
+** syscalls, and measurably slower on every device tested.
+**
+** 512 KiB is exactly SQLITE_OVVEC_MAX_PAGES at SQLite's default 4 KiB page
+** size, so this leaves the default configuration alone and only scales larger
+** pages down.
+*/
+#define SQLITE_OVVEC_MAX_BYTES (512*1024)
+
+typedef struct OvVecReadReq OvVecReadReq;
+
+struct OvVecReadReq {
+  i64 iOffset;              /* Byte offset of the lowest database page */
+  int nPage;                /* Number of contiguous pages */
+  int dir;                  /* +1 chain ascends, -1 chain descends */
+  int szPage;               /* SQLite page size */
+  int szPayload;            /* szPage - 4 */
+  unsigned char *pOut;      /* Final BLOB destination */
+  unsigned char *aNext;     /* 4 bytes per page */
+};
+
 int sqlite3OsFileControl(sqlite3_file*,int,void*);
 void sqlite3OsFileControlHint(sqlite3_file*,int,void*);
 #define SQLITE_FCNTL_DB_UNCHANGED 0xca093fa0
