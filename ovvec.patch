+  DbPage *pCached;
+  sqlite3_file *fd;
+  if( sqlite3PagerDirectReadOk(pBt->pPager, pgno) ) return 1;
+  if( !sqlite3PagerOvvecDiskOk(pBt->pPager, pgno) ) return 0;
+  fd = sqlite3PagerFile(pBt->pPager);
+  if( (fd->pMethods->xDeviceCharacteristics(fd)
+        & SQLITE_IOCAP_SUBPAGE_READ)==0 ){
+    return 0;
+  }
+  pCached = sqlite3PagerLookup(pBt->pPager, pgno);
+  if( pCached ){
+    sqlite3PagerUnref(pCached);
+    return 0;
+  }
+  return 1;
+}
